## Local development / direct Postgres mode
# Copy to `.env` and set your real password locally.
#
# IMPORTANT: Do not commit `.env` to git.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/catman

# Optional (backend mode). Leave empty when using direct Postgres.
# CATMAN_API_BASE_URL=http://127.0.0.1:8000

# Copy this file to .env and fill your values
DATA_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_KEY=
CATMAN_API_BASE_URL=http://127.0.0.1:8000

# Optional: comma-separated emails allowed for first SuperAdmin bootstrap
SUPERADMIN_BOOTSTRAP_EMAILS=

# Optional: quick login buttons on auth screen
SUPERADMIN_EMAIL=vitalik.1997.05.27@gmail.com
WORK_EMAIL=

# Optional fallback update URL (if DB policy has no URL)
# UPDATE_DOWNLOAD_URL=https://github.com/<owner>/<repo>/releases/latest/download/CatManPro.exe

# GSM Sheet (Extensions -> GSM Parser)
# Mode B (recommended): prepare "Режим фільтрації" + readonly lock via service account, then open /view?rm=minimal&fvid=...
GSM_SHEET_DIRECT=0
GSM_SHEET_URL=https://docs.google.com/spreadsheets/d/1WpkunksJZnJbaT9W62o5uWgR5tTD9AUq8PG23lys3Ok/edit?gid=0#gid=0

# Optional: before opening, try to write row-1 label "Режим фільтрації"
# Requires a Google service account JSON key file.
GSM_SHEET_PREPARE=1
# GSM_PARSER_GOOGLE_JSON=C:\path\to\service_account.json
# If you ever want anonymous/no-chrome display, you can provide a published /pubhtml link,
# but it will NOT support interactive "Режим фільтрації".
