# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs and runtime files
logs/
*.log

# Local secrets/config
.env
.env.*
!.env.*.example
config.txt
quick_accounts.json
super_admin_account.json

# Media user data
media/user_backgrounds/
media/company_backgrounds.json

# Build outputs
build/
dist/
*.spec
*.exe
*.msi
*.apk
*.aab
*.ipa

# Bundled portable Postgres for "Локал" storage mode (local_pg_manager.py) —
# real binaries, must NOT be caught by the *.exe ignore rule above.
!vendor/pgsql/**

# Separate workspace project (do not include in this app repo/release flow)
Парсер/

# Secrets / credentials (Google service account keys, GitHub publish token, etc.)
secrets/

# Local backups, build artifacts, Claude Code local session state
backups/
.program/
.claude/

# Stray/junk files
database.py.bak
scratch_*.txt
__noop_delete_me.tmp
--exclude=.venv
